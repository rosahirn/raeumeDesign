<script>
// Hex-Eingabe neben jedem Farbwähler (beidseitig synchron)
(function () {
  const norm = (v) => {
    v = v.trim().replace(/^#/, '').toLowerCase();
    if (/^[0-9a-f]{3}$/.test(v)) v = v.split('').map((c) => c + c).join('');
    return /^[0-9a-f]{6}$/.test(v) ? '#' + v : null;
  };
  const pairs = [];
  document.querySelectorAll('input[type="color"]').forEach((c) => {
    const t = document.createElement('input');
    t.type = 'text'; t.className = 'hex'; t.spellcheck = false; t.autocomplete = 'off'; t.maxLength = 7;
    const name = (c.closest('label')?.childNodes[0]?.textContent || 'Farbe').trim();
    t.setAttribute('aria-label', 'Hexwert ' + name);
    t.value = c.value;
    c.insertAdjacentElement('afterend', t);
    const apply = () => {
      const v = norm(t.value);
      t.setAttribute('aria-invalid', String(!v && t.value.trim() !== ''));
      if (v && v !== c.value) { c.value = v; c.dispatchEvent(new Event('input', { bubbles: true })); c.dispatchEvent(new Event('change', { bubbles: true })); }
    };
    t.addEventListener('input', apply);
    t.addEventListener('change', () => { apply(); const v = norm(t.value); if (v) t.value = v; });
    t.addEventListener('keydown', (e) => { if (e.key === 'Enter') { apply(); t.blur(); } e.stopPropagation(); });
    pairs.push([c, t]);
  });
  // Farbwähler -> Textfeld (auch wenn die App die Farbe per Preset setzt)
  const loop = () => { for (const [c, t] of pairs) if (document.activeElement !== t && norm(t.value) !== c.value) { t.value = c.value; t.setAttribute('aria-invalid', 'false'); } requestAnimationFrame(loop); };
  requestAnimationFrame(loop);
})();
</script>

