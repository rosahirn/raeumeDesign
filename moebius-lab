<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Möbius-Schlaufen</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;700&display=swap">
<style>
:root{ --bg:#ffffff; --ink:#1d1d1b; --muted:#55554f; --panel:#ffffffee; --line:#d9d9d4; --accent:#6a50ff; }
body[data-bg="soft"]{ --bg:#f3f1ec; }
body[data-bg="dark"]{ --bg:#1b1640; --ink:#f4f2ff; --muted:#c9c4ea; --panel:#241d55ee; --line:#3c3478; --accent:#b7aaff; }
*{box-sizing:border-box}
html,body{margin:0;height:100%}
body{background:var(--bg);color:var(--ink);font-family:'Atkinson Hyperlegible Next','Atkinson Hyperlegible',system-ui,sans-serif;font-size:16px;overflow:hidden;transition:background .2s}
#stage{position:fixed;inset:0;cursor:grab}
#stage:active{cursor:grabbing}
#stage canvas{display:block;width:100%;height:100%}
.hint{position:fixed;top:16px;left:340px;right:16px;margin:0;font-size:14px;color:var(--muted);pointer-events:none}
#panel,#editPanel{position:fixed;left:16px;top:16px;bottom:16px;width:308px;max-width:calc(100vw - 32px);overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:14px 16px 16px;backdrop-filter:blur(8px)}
#panel[data-open="false"]{bottom:auto}
#panel[data-open="false"] .body{display:none}
.head{display:flex;justify-content:space-between;align-items:center;gap:8px}
h1{font-size:17px;margin:0}
button,select{font:inherit;color:inherit;background:transparent;border:1.5px solid var(--line);border-radius:10px;padding:7px 11px;min-height:40px;cursor:pointer}
select{width:100%;background:var(--bg)}
button:hover{border-color:var(--ink)}
button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
button[aria-pressed="true"]{border-color:var(--ink);font-weight:700}
.body{display:flex;flex-direction:column;gap:12px;margin-top:12px}
details{border-top:1px solid var(--line);padding-top:10px}
summary{font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);cursor:pointer;min-height:28px;display:flex;align-items:center}
.sec{display:flex;flex-direction:column;gap:10px;margin-top:10px}
.row{display:grid;grid-template-columns:1fr auto;gap:2px 10px;align-items:center}
.row input[type=range]{grid-column:1/-1;width:100%;accent-color:var(--accent)}
output{font-variant-numeric:tabular-nums;color:var(--muted);font-size:14px}
.btns{display:flex;flex-wrap:wrap;gap:8px}
.colors{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.colors label,.field{display:flex;flex-direction:column;gap:4px;font-size:14px}
input[type=color]{width:100%;height:40px;border:1.5px solid var(--line);border-radius:10px;padding:2px;background:transparent;cursor:pointer}
.check{display:flex;align-items:center;gap:10px;min-height:32px}
.check input{width:20px;height:20px;accent-color:var(--accent)}
.primary{background:var(--ink);color:var(--bg);border-color:var(--ink);font-weight:700}
@media (max-width:700px){ #panel,#editPanel{top:auto;max-height:55vh} .hint{left:16px} }
.contrast{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px;font-size:14px}
.contrast li{display:flex;justify-content:space-between;gap:8px}
.contrast .ok{color:var(--ink)} .contrast .low{color:#b3261e} body[data-bg="dark"] .contrast .low{color:#ffb4a9}
button:disabled{opacity:.45;cursor:default}
</style>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&display=swap">
<style>
/* ---- technischer, kompakter Look ---- */
:root{ --mono:'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace; --r:2px; }
body{font-size:13px}
.hint{font-family:var(--mono);font-size:11px;letter-spacing:.02em;left:316px}
#panel,#editPanel{width:286px;top:12px;left:12px;bottom:12px;padding:0;border-radius:var(--r);border:1px solid var(--ink);background:var(--panel)}
.head{padding:8px 10px;border-bottom:1px solid var(--ink);position:sticky;top:0;background:var(--bg);z-index:2}
h1{font-family:var(--mono);font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase}
.body{gap:0;margin-top:0}
.block{padding:10px;display:flex;flex-direction:column;gap:6px;border-bottom:1px solid var(--line)}
.group-label{margin:0;padding:10px 10px 4px;font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--ink);border-top:1px solid var(--ink)}
details{border-top:1px solid var(--line);padding:6px 10px 8px}
.group-label + details{border-top:0}
summary{font-family:var(--mono);font-size:11px;letter-spacing:.06em;color:var(--ink);min-height:24px;list-style:none}
summary::-webkit-details-marker{display:none}
summary::before{content:'+';display:inline-block;width:14px;font-weight:600}
details[open] > summary::before{content:'–'}
.sec{gap:7px;margin-top:6px}
button,select,.text{font-size:12.5px;border-radius:var(--r);border:1px solid var(--line);min-height:30px;padding:4px 8px}
button{background:var(--bg)}
button:hover{border-color:var(--ink)}
button[aria-pressed="true"]{background:var(--ink);color:var(--bg);font-weight:600;border-color:var(--ink)}
.primary{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.wide{margin:10px 10px 0;width:calc(100% - 20px)}
.presets{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px}
.sub{margin:6px 0 0;font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);border-top:1px dashed var(--line);padding-top:8px}
.sec > .sub:first-child{border-top:0;padding-top:0;margin-top:0}
.checker{border:1px solid var(--line);padding:8px;display:flex;flex-direction:column;gap:6px}
.contrast .cov{color:var(--muted)}
.contrast .legendnote{font-size:10.5px;color:var(--muted);margin-top:2px}
.checker .sub{border-top:0;padding-top:0;margin:0;color:var(--ink)}
.presets button{font-size:11.5px;padding:3px 4px;min-height:28px}
.btns{gap:4px}
.btns.two{display:grid;grid-template-columns:1fr 1fr}
.btns.three{display:grid;grid-template-columns:repeat(3,1fr)}
.field,.colors label{font-size:12px;gap:3px}
.row{gap:0 8px}
.row label{font-size:12px}
output{font-family:var(--mono);font-size:11px}
input[type=range]{height:18px}
.check{min-height:24px;font-size:12px;gap:8px}
.check input{width:16px;height:16px}
.colors{gap:6px}
input[type=color]{height:26px;border-radius:var(--r);border:1px solid var(--line)}
.hex{font-family:var(--mono)!important;font-size:11px!important;border-radius:var(--r)!important;min-height:26px!important;padding:3px 6px!important;border-width:1px!important}
.text{font-family:var(--mono);background:var(--bg);color:inherit}
.note{margin:0;font-size:11.5px;color:var(--muted);line-height:1.4}
.note.wide, #panel > .body > .note{padding:4px 10px 12px}
.contrast{font-family:var(--mono);font-size:11px}
[hidden]{display:none!important}
@media (max-width:700px){ #panel,#editPanel{width:auto;right:12px} .hint{left:12px} }
.fab{position:fixed;right:12px;bottom:12px;z-index:5;font-family:var(--mono);font-size:12px;font-weight:600;letter-spacing:.04em;padding:8px 14px;min-height:36px;border:1px solid var(--ink);border-radius:var(--r);background:var(--ink);color:var(--bg)}
.fab[aria-pressed="true"]{background:var(--bg);color:var(--ink)}
.source{border:1px dashed var(--ink);padding:14px 10px;text-align:center;font-family:var(--mono);font-size:12px;cursor:grab;background:var(--bg);user-select:none}
.source:active{cursor:grabbing}
input[type=number].text{width:100%}
</style>
</head>
<body data-bg="white">
<div id="stage" role="img" aria-label="Ein Möbiusband, das drei Schlaufen bildet, in flachen Farben mit Kontur. Ziehen zum Drehen, scrollen zum Zoomen."></div>
<p class="hint">Ziehen = drehen · Scrollen = zoomen · Rechtsklick ziehen = verschieben</p>
<section id="panel" data-open="true" aria-label="Einstellungen">
  <div class="head"><h1>Möbius-Schlaufen</h1><button id="togglePanel" aria-expanded="true">Einklappen</button></div>
  <div class="body">

    <div class="block">
      <button id="random" class="primary">⚄ Zufall – alles neu würfeln</button>
      <div class="btns two"><button id="undo" title="Strg+Z">↶ Rückgängig</button><button id="redo" title="Strg+Umschalt+Z">↷ Wiederholen</button></div>
    </div>

    <details open><summary>1 · Art des Bands</summary><div class="sec">
      <div class="presets" role="group" aria-label="Band-Arten">
        <button data-preset="zwei">2 Schlaufen</button>
        <button data-preset="bluete">Blüte</button>
        <button data-preset="knoten">Knoten</button>
        <button data-preset="wild">Wild</button>
      </div>
      <label class="field">Grundform
        <select id="path"><option value="schlaufen">Schlaufen (überkreuzt)</option><option value="bluete">Blüte (ohne Kreuzung)</option><option value="knoten">Knoten</option></select>
      </label>
      <div class="row"><label for="twists">Halbe Drehungen</label><output id="twistsOut"></output><input type="range" id="twists" min="0" max="9" step="1"></div>
      <p id="twistNote" class="note"></p>
    </div></details>

    <details open><summary>2 · Schlaufen</summary><div class="sec">
      <div class="row"><label for="loops">Anzahl Schlaufen</label><output id="loopsOut"></output><input type="range" id="loops" min="2" max="3" step="1"></div>
      <div class="row"><label for="loopSize">Schlaufengröße</label><output id="loopSizeOut"></output><input type="range" id="loopSize" min="0" max="1" step="0.01"></div>
      <div class="row"><label for="roll">Band rollen (°)</label><output id="rollOut"></output><input type="range" id="roll" min="0" max="180" step="1"></div>
      <p class="note">Grundform und Schlaufen-Regler setzen die Ziehpunkte neu.</p>
    </div></details>

    <details open><summary>3 · Form bearbeiten</summary><div class="sec">
      <button id="handles" aria-pressed="true">Ziehpunkte: an</button>
      <p class="note">Punkt anklicken und ziehen. Er bewegt sich parallel zum Bildschirm, also erst drehen, dann ziehen.</p>
      <div class="btns two"><button id="prevPt">← Punkt</button><button id="nextPt">Punkt →</button></div>
      <p id="pointNone" class="note">Kein Punkt ausgewählt.</p>
      <div id="pointBox" class="sec" hidden>
        <strong id="pointLabel"></strong>
        <div class="row"><label for="pw">Breite an diesem Punkt</label><output id="pwOut"></output><input type="range" id="pw" min="0.1" max="4" step="0.01"></div>
        <div class="row"><label for="px">Position X</label><output id="pxOut"></output><input type="range" id="px" min="-3" max="3" step="0.01"></div>
        <div class="row"><label for="py">Position Y (Höhe)</label><output id="pyOut"></output><input type="range" id="py" min="-2" max="2" step="0.01"></div>
        <div class="row"><label for="pz">Position Z</label><output id="pzOut"></output><input type="range" id="pz" min="-3" max="3" step="0.01"></div>
      </div>
      <div class="btns two"><button id="resetWidths">Breiten zurücksetzen</button><button id="resetPoints">Form zurücksetzen</button></div>
      <p class="sub">Band</p>
      <div class="row"><label for="width">Grundbreite</label><output id="widthOut"></output><input type="range" id="width" min="0.05" max="2" step="0.01"></div>
      <div class="row"><label for="thick">Materialstärke</label><output id="thickOut"></output><input type="range" id="thick" min="0.005" max="0.4" step="0.005"></div>
      <div class="row"><label for="widthWave">Breite pulsieren</label><output id="widthWaveOut"></output><input type="range" id="widthWave" min="0" max="0.95" step="0.01"></div>
      <div class="row"><label for="widthFreq">Pulse pro Umlauf</label><output id="widthFreqOut"></output><input type="range" id="widthFreq" min="1" max="12" step="1"></div>
      <div class="row"><label for="noise">Verformen</label><output id="noiseOut"></output><input type="range" id="noise" min="0" max="0.35" step="0.005"></div>
      <label class="check"><input type="checkbox" id="flow"> Fließen (Endlosschleife, 8 s)</label>
      <p class="sub">Einschnürung (Versuch)</p>
      <div class="row"><label for="pinch">Stärke (1 = läuft zum Punkt zusammen)</label><output id="pinchOut"></output><input type="range" id="pinch" min="0" max="1" step="0.01"></div>
      <div class="row" data-show="pinch"><label for="pinchPos">Stelle (°)</label><output id="pinchPosOut"></output><input type="range" id="pinchPos" min="0" max="360" step="1"></div>
      <div class="row" data-show="pinch"><label for="pinchLen">Länge des Übergangs</label><output id="pinchLenOut"></output><input type="range" id="pinchLen" min="0.01" max="0.3" step="0.005"></div>
      <div class="row" data-show="pinch"><label for="pinchCount">Anzahl Stellen</label><output id="pinchCountOut"></output><input type="range" id="pinchCount" min="1" max="4" step="1"></div>
      <label class="check" data-show="pinch"><input type="checkbox" id="pinchThick"> Auch die Materialstärke schmal werden lassen</label>
    </div></details>

    <details open><summary>4 · Farbe &amp; Linie</summary><div class="sec">
      <p class="sub">Farben</p>
      <div class="colors">
        <label>Farbe 1<input type="color" id="col0"></label>
        <label>Farbe 2<input type="color" id="col1"></label>
        <label>Farbe 3<input type="color" id="col2"></label>
      </div>
      <div class="colors"><label>Kontur<input type="color" id="colLine"></label></div>
      <label class="field">Farben laden
        <select id="scheme"><option value="">– auswählen –</option><option value="kontrast">Hoher Kontrast</option><option value="ci">CI (Indigo, Lila, Apricot)</option></select>
      </label>
      <div class="checker" role="region" aria-labelledby="checkerTitle">
        <p class="sub" id="checkerTitle">Kontrast-Check · Barrierefreiheit</p>
        <p class="note">Prüft die Farben nach WCAG 2.2: Grafische Elemente brauchen mindestens 3:1 zum Hintergrund und zueinander, damit man sie auch bei Sehschwäche unterscheiden kann. ✓ = erfüllt, ! = zu schwach, ○ = über die Kontur gelöst.</p>
        <ul id="contrast" class="contrast" aria-label="Kontrastwerte"></ul>
      </div>
      <label class="field">Farbverteilung
        <select id="colorMode"><option value="loops">Eine Farbe pro Schlaufe</option><option value="one1">Einfarbig: Farbe 1</option><option value="one2">Einfarbig: Farbe 2</option><option value="one3">Einfarbig: Farbe 3</option><option value="segments">Abschnitte im Wechsel (1 → 2 → 3)</option><option value="accent">Eine Schlaufe hervorheben</option><option value="pinch">Einschnürung hervorheben</option></select>
      </label>
      <div class="row" data-show="segments"><label for="segCount">Anzahl Abschnitte</label><output id="segCountOut"></output><input type="range" id="segCount" min="2" max="30" step="1"></div>
      <div class="row" data-show="accent"><label for="accent">Hervorgehobene Schlaufe</label><output id="accentOut"></output><input type="range" id="accent" min="1" max="3" step="1"></div>
      <label class="field">Kantenfarbe
        <select id="edgeColor"><option value="line">Konturfarbe</option><option value="auto">Automatisch kontrastreich (schwarz/weiß)</option><option value="c0">Farbe 1</option><option value="c1">Farbe 2</option><option value="c2">Farbe 3</option><option value="loops">Wie das Band</option></select>
      </label>
      <label class="field">Seitenflächen (Materialstärke)
        <select id="sideColor"><option value="auto">Automatisch (dünn = Kontur, dick = Band)</option><option value="line">Konturfarbe</option><option value="band">Bandfarbe</option><option value="edge">Kantenfarbe</option></select>
      </label>

      <p class="sub">Streifen</p>
      <label class="field">Muster
        <select id="pattern"><option value="none">Kein Muster</option><option value="laengs">Längsstreifen (entlang des Bands)</option><option value="quer">Querstreifen (über das Band)</option></select>
      </label>
      <div class="row" data-show="stripes"><label for="stripeW">Streifendicke</label><output id="stripeWOut"></output><input type="range" id="stripeW" min="0.02" max="0.5" step="0.005"></div>
      <label class="field" data-show="stripes">Streifenfarben
        <select id="stripeCols"><option value="12">Farbe 1 + 2</option><option value="123">Farbe 1 + 2 + 3</option></select>
      </label>

      <p class="sub">Linie &amp; Kanten</p>
      <label class="field">Darstellung
        <select id="display"><option value="band">Band</option><option value="mesh">Raster (schwarzes Gitternetz)</option><option value="edges">Nur Kanten</option></select>
      </label>
      <label class="field" data-show="mesh">Rasterart
        <select id="meshType"><option value="tri">Dreiecke (3D-Mesh)</option><option value="quad">Quadrate</option></select>
      </label>
      <div class="row" data-show="mesh"><label for="meshDensity">Feinheit des Rasters</label><output id="meshDensityOut"></output><input type="range" id="meshDensity" min="2" max="40" step="1"></div>
      <div class="row" data-show="mesh"><label for="meshLW">Stärke der Rasterlinien</label><output id="meshLWOut"></output><input type="range" id="meshLW" min="0.002" max="0.03" step="0.001"></div>
      <label class="check" data-show="mesh"><input type="checkbox" id="meshFill"> Fläche weiß füllen (verdeckt die Rückseite)</label>
      <div class="row"><label for="outline">Linienstärke (0 = aus)</label><output id="outlineOut"></output><input type="range" id="outline" min="0" max="0.04" step="0.001"></div>
    </div></details>

    <details open><summary>5 · Filter</summary><div class="sec">
      <label class="field">Filter
        <select id="filter"><option value="none">Kein Filter</option><option value="pixel">Pixel</option><option value="dither">Dithering</option><option value="halftone">Halbton (Punkte)</option><option value="lines">Linienraster</option><option value="riso">Riso-Fehldruck</option></select>
      </label>
      <div class="row" data-show="filter"><label for="fSize">Rastergröße (px)</label><output id="fSizeOut"></output><input type="range" id="fSize" min="1" max="32" step="1"></div>
      <label class="field" data-show="dither">Dithering-Farben
        <select id="ditherMode"><option value="palette">Mit den Bandfarben</option><option value="two">Nur Kontur + Hintergrund (1 Bit)</option></select>
      </label>
      <div class="row" data-show="strength"><label for="fSpread">Stärke</label><output id="fSpreadOut"></output><input type="range" id="fSpread" min="0" max="1.5" step="0.01"></div>
      <div class="row" data-show="raster"><label for="fAngle">Winkel (Raster / Versatz)</label><output id="fAngleOut"></output><input type="range" id="fAngle" min="0" max="90" step="1"></div>
      <label class="check" data-show="noisy"><input type="checkbox" id="fAnim"> Rauschen flimmern lassen</label>
      <p class="note" data-show="filter">Filter sind ein gestalterischer Effekt und machen Formen weniger klar lesbar. Für barrierearme Fassungen ohne Filter oder mit großer Rastergröße.</p>
    </div></details>

    <details><summary>6 · Speichern &amp; Laden</summary><div class="sec">
      <label class="field">Name (optional)<input type="text" id="saveName" placeholder="z. B. Logo-Variante A" class="text"></label>
      <button id="saveNew" class="primary">Aktuellen Stand speichern</button>
      <label class="field">Gespeicherte Stände<select id="saves"></select></label>
      <div class="btns two"><button id="saveLoad">Laden</button><button id="saveDelete">Löschen</button></div>
      <div class="btns two"><button id="exportJson">Als Datei exportieren</button><button id="importJson">Datei laden</button></div>
      <input type="file" id="importFile" accept=".json,application/json" hidden>
      <p id="saveNote" role="status" class="note"></p>
      <p class="note">Gespeichert wird in diesem Browser. Zum Weitergeben oder Sichern: als Datei exportieren.</p>
    </div></details>

    <button id="png" class="primary wide">PNG exportieren</button>
    <p class="note">Ohne Ziehpunkte. Mit Filter nicht transparent.</p>
  </div>
</section>


<section id="editPanel" aria-label="Typo-Raster bearbeiten" hidden>
  <div class="head"><h1>Typo-Raster · 10 × 10</h1></div>
  <div class="body">
    <details open><summary>1 · Schlaufe einsetzen</summary><div class="sec">
      <div id="eSource" class="source" draggable="true" role="button" tabindex="0" aria-describedby="eSourceHint">⠿ Schlaufe ins Raster ziehen</div>
      <p class="note" id="eSourceHint">Ziehe die Schlaufe auf eine Zelle. Sie übernimmt Form, Farben und Stil aus der Schlaufen-Ansicht.</p>
      <p class="sub">Ohne Maus</p>
      <div class="btns two">
        <label class="field">Zeile<input type="number" id="eRow" min="1" max="10" value="1" class="text"></label>
        <label class="field">Spalte<input type="number" id="eCol" min="1" max="10" value="1" class="text"></label>
      </div>
      <button id="ePlace">In diese Zelle setzen</button>
      <div class="btns two"><button id="eFill">Leere Zellen füllen</button><button id="eClear">Raster leeren</button></div>
      <p class="note" id="eCount"></p>
    </div></details>

    <details open><summary>2 · Bearbeiten</summary><div class="sec">
      <p class="note">In eine belegte Zelle klicken: Ziehpunkte erscheinen. An den Punkten ziehen verformt nur diese Kopie. Irgendwo in der Zelle ziehen = Schlaufe in eine andere Zelle verschieben (tauscht bei belegter Zelle), aus dem Raster ziehen = entfernen.</p>
      <p id="eNone" class="note">Keine Schlaufe ausgewählt.</p>
      <div id="eSelBox" class="sec" hidden>
        <strong id="eSelLabel"></strong>
        <div class="row" id="ePwRow"><label for="ePw">Breite am gewählten Punkt</label><output id="ePwOut"></output><input type="range" id="ePw" min="0.1" max="4" step="0.01"></div>
        <div class="btns two"><button id="eReset">Form zurücksetzen</button><button id="eRemove">Entfernen (Entf)</button></div>
      </div>
    </div></details>

    <details open><summary>3 · Typo speichern &amp; laden</summary><div class="sec">
      <label class="field">Name (optional)<input type="text" id="eSaveName" placeholder="z. B. Wortbild A" class="text"></label>
      <button id="eSave" class="primary">Typo speichern</button>
